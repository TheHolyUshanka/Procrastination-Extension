{
    "version": "1.0.0",
    "manifest_version": 3,
    "name": "Pomodoro Reminder",
    "description": "Pomodoro & Procrastination reminder tool",
    "action": {
        "default_popup": "js/index.html",
        "default_title": "React Chrome Extension"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
      },
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "storage",
        "webRequest",
        "idle",
        "alarms",
        "history"
      ],
      "host_permissions": [
        "https://parseapi.back4app.com/"
      ],
      "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
      },
      "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["content.js"]
        }
      ]
}